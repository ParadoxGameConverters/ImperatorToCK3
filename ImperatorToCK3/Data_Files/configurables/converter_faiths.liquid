# This file contains the converter's CK3 faiths that may be redundant in the case
# of a conversion to The Fallen Eagle or When the World Stopped Making Sense mods.
#
# For example: converter's berber_pagan faith is made redundant by TFE's amazigh_pagan.
# It's also not needed if any selected CK3 mod already has a berber_pagan faith.
# To prevent including the faith in the conversion, add a list of faiths that
# invalidate it to the faith's definition:
# INVALIDATED_BY = { berber_pagan amazigh_pagan }
#
# CK3 1.20+ (By God Alone) format
# -------------------------------
# Every faith is a top-level block and references its religion in a faith_details block.
# Tenets are listed separately from doctrines, and holy sites are split into regular and
# eminent ones (up to the religion's eminent_holy_sites_max, default 3):
#
# my_faith = {
#     faith_details = {
#         religion = my_religion
#         color = rgb { 100 100 100 }
#         icon = my_icon
#         reformed_icon = my_reformed_icon
#         religious_head = d_my_head
#         head_of_rite = k_my_head
#     }
#     holy_sites = { site_1 site_2 }
#     eminent_holy_sites = { site_3 }
#     tenets = { tenet_1 tenet_2 }
#     doctrines = { doctrine_1 }
#     localization = { ... }
# }
#
# The faiths' religions are defined in converter_religions.liquid. A religion that
# already exists in the game or in a loaded mod is left untouched.

