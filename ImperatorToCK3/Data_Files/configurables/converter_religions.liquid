# This file contains CK3 religions added by the converter.
#
# In CK3 1.20+ (By God Alone) religions, faiths and rites are defined in separate folders:
#   common/religion/religion_types
#   common/religion/faith_types
#   common/religion/rite_types
#
# Every religion must define its family in a religion_details block:
#
# my_religion = {
#     religion_details = {
#         family = rf_pagan                 # Required
#         graphical_faith = pagan_gfx       # Optional, inherited by the religion's faiths
#         piety_icon_group = pagan          # Optional, inherited by the religion's faiths
#         theocracy_government_type = theocracy_government
#         theocracy_lease_contract_type = theocracy_lease
#     }
#
#     # Optional holy site limits for the religion's faiths (defaults shown):
#     eminent_holy_sites_max = 3
#     eminent_holy_sites_min = 1
#     holy_sites_max = 9                    # Total, including eminent holy sites
#     holy_sites_min = 1
#     main_holy_site = key                  # Cannot be removed from the religion's faiths
#
#     doctrine = doctrine_polytheist        # Religion doctrines apply to all of its faiths
#     pagan_roots = yes
#     localization = { ... }
# }
#
# Religions that already exist in the game or in a loaded mod are left untouched,
# so only religions created by the converter need to be defined here.
# The faiths of all converter religions are defined in converter_faiths.liquid.

