#################
# The Silk Road #
#################
{% if wtwsms or tfe %}
# The Silk Road shouldn't trigger when using a mod without East Asia
## TFE doesn't explicitly disable the Silk Road, but because the situation is set to start after all TFE start dates, it never starts in TFE

{% else %}
# The base game sets the start date as Jan 1, 552, since that's apparently when Silkworms were smuggled into Byzantium, but for now, will just make sure it starts at game start

1.1.1 = {
	effect = {
		if = {
			limit = { has_tgp_dlc_trigger = yes }
			start_situation = {
				type = silk_road_situation
			}
		}		
	}
}

{% endif %}